#!/usr/bin/env bash
# Runs the combined fan and power dashboard from this checkout (src/), using the Python of the installed app.
# By default it starts detached from the terminal, so the terminal can be closed. Close the window to stop it.
# --foreground keeps it attached to the terminal and prints its messages there.
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Ubuntu 26.04's sudo (sudo-rs) has no -E and resets the environment, so as root the window cannot find the desktop.
# Under sudo, point it back at the invoking user's session: Wayland socket, Xwayland cookie and session bus.
if [[ -n "${SUDO_UID:-}" && -d "/run/user/$SUDO_UID" ]]; then
    runtime="/run/user/$SUDO_UID"
    export XDG_RUNTIME_DIR="$runtime"
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        socket="$(find "$runtime" -maxdepth 1 -type s -name 'wayland-[0-9]*' -printf '%f\n' 2>/dev/null | sort | head -n 1 || true)"
        [[ -n "$socket" ]] && export WAYLAND_DISPLAY="$socket"
    fi
    if [[ -z "${XAUTHORITY:-}" ]]; then
        cookie="$(ls -t "$runtime"/.mutter-Xwaylandauth.* 2>/dev/null | head -n 1 || true)"
        [[ -n "$cookie" ]] && export XAUTHORITY="$cookie"
    fi
    if [[ -z "${DISPLAY:-}" ]]; then
        x_socket="$(find /tmp/.X11-unix -maxdepth 1 -type s -name 'X[0-9]*' -printf '%f\n' 2>/dev/null | sort -V | head -n 1 || true)"
        [[ -n "$x_socket" ]] && export DISPLAY=":${x_socket#X}"
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$runtime/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
    fi
fi
# Prefer Wayland when the session has it, with X11 as the fallback.
if [[ -n "${WAYLAND_DISPLAY:-}" && -z "${QT_QPA_PLATFORM:-}" ]]; then
    export QT_QPA_PLATFORM="wayland;xcb"
fi

python_bin=""
app_command="$(command -v omen-fan-control || true)"
if [[ -n "$app_command" ]]; then
    candidate="$(dirname -- "$(readlink -f -- "$app_command")")/python"
    [[ -x "$candidate" ]] && python_bin="$candidate"
fi
# sudo resets PATH, so also look in the invoking user's pipx venv.
if [[ -z "$python_bin" && -n "${SUDO_USER:-}" ]]; then
    user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    candidate="$user_home/.local/share/pipx/venvs/omen-fan-control/bin/python"
    [[ -x "$candidate" ]] && python_bin="$candidate"
fi
if [[ -z "$python_bin" ]] && python3 -c 'import PyQt6, click' 2>/dev/null; then
    python_bin="$(command -v python3)"
fi
if [[ -z "$python_bin" ]]; then
    echo 'PyQt6 and click were not found. Install omen-fan-control first.' >&2
    exit 1
fi
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
foreground=0
app_args=()
for arg in "$@"; do
    case "$arg" in
        --foreground) foreground=1 ;;
        --background) ;; # The default. Still accepted so existing commands keep working.
        *) app_args+=("$arg") ;;
    esac
done

if [[ "$foreground" -eq 1 ]]; then
    exec "$python_bin" -m omen_fan_control.gui "${app_args[@]}"
fi

# setsid gives the app its own session, so closing the terminal does not reach it.
log="${XDG_RUNTIME_DIR:-/tmp}/omen-dashboard.log"
setsid -f "$python_bin" -m omen_fan_control.gui "${app_args[@]}" </dev/null >"$log" 2>&1
sleep 1
if pgrep -f -- "-m omen_fan_control.gui" >/dev/null; then
    echo "Omen Control is running in the background. Close its window (X) to stop it. Log: $log"
else
    echo "Omen Control stopped right after starting. Last lines of $log:" >&2
    tail -n 5 "$log" >&2
    exit 1
fi
